<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inherit Users Tree View: Add Kuota Harian & Contact Columns -->
        <record id="view_users_tree_helpdesk" model="ir.ui.view">
            <field name="name">res.users.tree.helpdesk</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="initials" string="Initial"/>
                    <field name="function" string="Function"/>
                    <field name="max_daily_quota" string="Kuota Harian"/>
                </xpath>
                <xpath expr="//field[@name='login']" position="replace">
                    <field name="email" string="Email"/>
                    <field name="phone" string="Phone"/>
                </xpath>
            </field>
        </record>

        <!-- Inherit Users Form View: Clean Layout & Standard Font Size -->
        <record id="view_users_form_helpdesk" model="ir.ui.view">
            <field name="name">res.users.form.helpdesk</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <!-- Clean oe_title: only title name -->
                <xpath expr="//div[hasclass('oe_title')]" position="replace">
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. John Doe" required="1"/></h1>
                        <field name="login" invisible="1"/>
                    </div>
                </xpath>

                <!-- Standardized identity & contact group outside oe_title for standard font size -->
                <xpath expr="//div[hasclass('oe_title')]" position="after">
                    <group string="User Identity &amp; Contact Information">
                        <group>
                            <field name="initials" string="Initial" placeholder="e.g. AFD"/>
                            <field name="function" string="Function / Jabatan" placeholder="e.g. Engineer SAP &amp; Keuangan"/>
                            <field name="max_daily_quota" string="Batas Kuota Harian (Tiket)"/>
                        </group>
                        <group>
                            <field name="email" string="Email *" required="1" placeholder="e.g. user@hkinfrastruktur.com"/>
                            <field name="phone" string="Phone" widget="phone" placeholder="e.g. 0812-3456-7890"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
