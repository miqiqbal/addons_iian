<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_helpdesk_my_ticket_kanban" model="ir.ui.view">
            <field name="name">helpdesk.ticket.my.kanban</field>
            <field name="model">helpdesk.ticket</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="title"/>
                    <field name="service_id"/>
                    <field name="priority"/>
                    <field name="engineer_id"/>
                    <field name="state"/>
                    <field name="sla_resolution_deadline"/>
                    <field name="sla_resolution_breached"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/> - <field name="title"/>
                                        </strong>
                                    </div>
                                    <field name="priority" widget="badge"
                                           decoration-danger="priority == '1'"
                                           decoration-warning="priority == '2'"
                                           decoration-info="priority == '3'"
                                           decoration-success="priority == '4'"/>
                                </div>
                                <div>
                                    <i class="fa fa-cogs" title="Service"/> <field name="service_id"/>
                                </div>
                                <div>Engineer: <field name="engineer_id"/></div>
                                <div>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'new'"
                                           decoration-warning="state in ('assigned', 'pending')"
                                           decoration-primary="state == 'in_progress'"
                                           decoration-success="state == 'resolved'"
                                           decoration-muted="state == 'closed'"
                                           decoration-danger="state == 'cancelled'"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="sla_status_label" widget="badge"
                                               decoration-success="sla_status_label == 'on_track'"
                                               decoration-warning="sla_status_label == 'warning'"
                                               decoration-danger="sla_status_label in ('critical', 'breached')"/>
                                        <span class="ml-2 text-muted small">
                                            Due: <field name="sla_resolution_deadline" widget="date"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_helpdesk_my_ticket_search" model="ir.ui.view">
            <field name="name">helpdesk.ticket.my.search</field>
            <field name="model">helpdesk.ticket</field>
            <field name="arch" type="xml">
                <search>
                    <field name="title"/>
                    <field name="service_id"/>
                    <field name="engineer_id"/>
                    <filter string="All" name="filter_all" domain="[]"/>
                    <filter string="Open" name="filter_open"
                            domain="[('state', 'in', ['new', 'assigned', 'in_progress'])]"/>
                    <filter string="Pending" name="filter_pending" domain="[('state', '=', 'pending')]"/>
                    <filter string="Resolved" name="filter_resolved" domain="[('state', '=', 'resolved')]"/>
                    <filter string="Closed" name="filter_closed" domain="[('state', '=', 'closed')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_helpdesk_my_ticket" model="ir.actions.act_window">
            <field name="name">My Ticket</field>
            <field name="res_model">helpdesk.ticket</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="domain">['|', ('create_uid', '=', uid), ('requester_id', '=', uid)]</field>
            <field name="search_view_id" ref="view_helpdesk_my_ticket_search"/>
        </record>

        <record id="action_helpdesk_my_ticket_view_kanban" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="view_helpdesk_my_ticket_kanban"/>
            <field name="act_window_id" ref="action_helpdesk_my_ticket"/>
        </record>

        <!-- Assigned to Me Action (Khusus Engineer / PIC IT) -->
        <record id="action_helpdesk_assigned_to_me" model="ir.actions.act_window">
            <field name="name">Assigned to Me</field>
            <field name="res_model">helpdesk.ticket</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="domain">[('engineer_id', '=', uid)]</field>
            <field name="search_view_id" ref="view_helpdesk_my_ticket_search"/>
        </record>

    </data>
</odoo>
