<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="module_helpdesk_category" model="ir.module.category">
            <field name="name">IT Helpdesk</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_helpdesk_user" model="res.groups">
            <field name="name">Employee</field>
            <field name="category_id" ref="module_helpdesk_category"/>
            <field name="comment">Karyawan / Requester: Bisa membuat &amp; melihat tiketnya sendiri, serta akses baca master data.</field>
        </record>

        <!-- Default Access: Semua Internal User Odoo otomatis mewarisi role Employee -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('it_helpdesk_v2.group_helpdesk_user'))]"/>
        </record>

        <record id="group_helpdesk_agent" model="res.groups">
            <field name="name">Manager Dept.</field>
            <field name="category_id" ref="module_helpdesk_category"/>
            <field name="implied_ids" eval="[(4, ref('group_helpdesk_user'))]"/>
            <field name="comment">Manager Departemen Terkait: Persetujuan (approval) Change Request &amp; monitoring antrean progres.</field>
        </record>

        <record id="group_helpdesk_it_manager" model="res.groups">
            <field name="name">IT Manager</field>
            <field name="category_id" ref="module_helpdesk_category"/>
            <field name="implied_ids" eval="[(4, ref('group_helpdesk_agent'))]"/>
            <field name="comment">Manager IT: Persetujuan (approval) Change Request level IT, pengawasan tiket &amp; analitik dashboard.</field>
        </record>

        <record id="group_helpdesk_manager" model="res.groups">
            <field name="name">IT Admin</field>
            <field name="category_id" ref="module_helpdesk_category"/>
            <field name="implied_ids" eval="[(4, ref('group_helpdesk_it_manager')), (4, ref('base.group_erp_manager'))]"/>
            <field name="comment">Akses penuh administrator: seluruh tiket, master data/konfigurasi, dan manajemen pengguna/peran.</field>
        </record>



        <record id="rule_helpdesk_ticket_base_user" model="ir.rule">
            <field name="name">Helpdesk Ticket: Base User - akses tiket</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_helpdesk_ticket_employee" model="ir.rule">
            <field name="name">Helpdesk Ticket: Employee - akses baca semua tiket</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_helpdesk_ticket_agent" model="ir.rule">
            <field name="name">Helpdesk Ticket: Agent - akses penuh tiket</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_agent'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <record id="rule_helpdesk_ticket_manager" model="ir.rule">
            <field name="name">Helpdesk Ticket: Manager - akses penuh</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_manager'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- Record rules: helpdesk.work.order -->

        <record id="rule_helpdesk_work_order_base_user" model="ir.rule">
            <field name="name">Helpdesk Work Order: Base User - akses penuh</field>
            <field name="model_id" ref="model_helpdesk_work_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_helpdesk_work_order_employee" model="ir.rule">
            <field name="name">Helpdesk Work Order: Employee - akses baca semua work order</field>
            <field name="model_id" ref="model_helpdesk_work_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Agent & Manager juga otomatis anggota group_helpdesk_user (implied_ids),
             jadi tanpa rule eksplisit di sini mereka akan ikut terbatasi oleh rule
             Employee di atas (ir.rule antar-group di-OR, bukan di-AND). Rule ini
             memberi mereka visibilitas penuh sesuai "read/write Agent & Manager"
             tanpa domain restriction, sesuai spesifikasi Stage 12. -->
        <record id="rule_helpdesk_work_order_agent" model="ir.rule">
            <field name="name">Helpdesk Work Order: Agent - akses penuh</field>
            <field name="model_id" ref="model_helpdesk_work_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_agent'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_helpdesk_work_order_manager" model="ir.rule">
            <field name="name">Helpdesk Work Order: Manager - akses penuh</field>
            <field name="model_id" ref="model_helpdesk_work_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_manager'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- Record rules: helpdesk.change.request -->

        <record id="rule_helpdesk_change_request_base_user" model="ir.rule">
            <field name="name">Helpdesk Change Request: Base User - akses requester atau approver/engineer</field>
            <field name="model_id" ref="model_helpdesk_change_request"/>
            <field name="domain_force">['|', '|', '|', '|', '|', '|', ('created_by', '=', user.id), ('dept_manager_id', '=', user.id), ('kadept_manager_id', '=', user.id), ('bpo_kadept_manager_id', '=', user.id), ('manager_it_id', '=', user.id), ('kadept_it_manager_id', '=', user.id), ('engineer_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_helpdesk_change_request_employee" model="ir.rule">
            <field name="name">Helpdesk Change Request: Employee - akses requester atau approver/engineer</field>
            <field name="model_id" ref="model_helpdesk_change_request"/>
            <field name="domain_force">['|', '|', '|', '|', '|', '|', ('created_by', '=', user.id), ('dept_manager_id', '=', user.id), ('kadept_manager_id', '=', user.id), ('bpo_kadept_manager_id', '=', user.id), ('manager_it_id', '=', user.id), ('kadept_it_manager_id', '=', user.id), ('engineer_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>


        <record id="rule_helpdesk_change_request_agent" model="ir.rule">
            <field name="name">Helpdesk Change Request: Agent - akses penuh</field>
            <field name="model_id" ref="model_helpdesk_change_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_agent'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_helpdesk_change_request_manager" model="ir.rule">
            <field name="name">Helpdesk Change Request: Manager - akses penuh</field>
            <field name="model_id" ref="model_helpdesk_change_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_manager'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <record id="rule_helpdesk_change_request_it_manager" model="ir.rule">
            <field name="name">Helpdesk Change Request: IT Manager - akses penuh</field>
            <field name="model_id" ref="model_helpdesk_change_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_it_manager'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>


        <!-- Record rule: res.partner fallback for Helpdesk Users & CC -->
        <record id="rule_res_partner_helpdesk_access" model="ir.rule">
            <field name="name">Res Partner: Access for IT Helpdesk Users &amp; CC</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

    </data>
</odoo>
