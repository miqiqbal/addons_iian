<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_helpdesk_ticket_create_form" model="ir.ui.view">
            <field name="name">helpdesk.ticket.create.form</field>
            <field name="model">helpdesk.ticket</field>
            <field name="arch" type="xml">
                <form string="Create Ticket">
                    <header>
                        <button name="action_publish" string="Publish" type="object" class="btn-success font-weight-bold" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button name="action_cancel" string="Cancel" type="object" class="btn-danger font-weight-bold" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button name="action_assign_engineer" string="Assign / Eskalasi ke Engineer" type="object" class="btn-warning font-weight-bold" groups="it_helpdesk_v2.group_helpdesk_manager" attrs="{'invisible': [('state', '!=', 'open')]}"/>
                        <button name="action_open_reassign_wizard" string="Eskalasi / Reassign Engineer" type="object" class="btn-warning font-weight-bold" groups="it_helpdesk_v2.group_helpdesk_manager" attrs="{'invisible': [('state', 'in', ['draft', 'closed', 'reject'])]}"/>
                        <button name="action_start_progress" string="Start Progress" type="object" class="btn-primary font-weight-bold" groups="it_helpdesk_v2.group_helpdesk_agent,it_helpdesk_v2.group_helpdesk_manager" attrs="{'invisible': [('state', 'not in', ['open', 'assigned'])]}"/>
                        <button name="action_done" string="Mark as Done" type="object" class="btn-success font-weight-bold" groups="it_helpdesk_v2.group_helpdesk_agent,it_helpdesk_v2.group_helpdesk_manager" attrs="{'invisible': [('state', '!=', 'in_progress')]}"/>
                        <button name="action_reopen_progress" string="Kembalikan ke Progress" type="object" class="btn-warning font-weight-bold" groups="it_helpdesk_v2.group_helpdesk_manager" attrs="{'invisible': [('state', 'not in', ['done', 'closed'])]}"/>
                        <button name="action_reopen_assigned" string="Kembalikan ke Assigned (Reopen)" type="object" class="btn-outline-danger font-weight-bold" groups="it_helpdesk_v2.group_helpdesk_manager" attrs="{'invisible': [('state', 'not in', ['done', 'closed'])]}"/>
                        <button name="action_close" string="Close Ticket" type="object" class="btn-secondary" groups="it_helpdesk_v2.group_helpdesk_manager" attrs="{'invisible': [('state', '!=', 'done')]}"/>
                        <button name="action_open_reject_wizard" string="Reject Ticket" type="object" class="btn-danger" attrs="{'invisible': ['|', ('can_reject', '=', False), ('state', 'in', ['draft', 'done', 'closed', 'reject'])]}"/>

                        <field name="state" widget="statusbar" statusbar_visible="draft,open,assigned,in_progress,done,closed"/>
                    </header>
                    <sheet class="w-100" style="max-width: 100% !important; width: 100% !important; margin: 0 !important; padding: 25px 35px !important;">
                        <field name="requester_id" invisible="1"/>
                        <field name="is_engineer_or_officer" invisible="1"/>
                        <field name="can_reject" invisible="1"/>


                        <!-- Alert Banner for Draft -->
                        <div class="alert alert-info" role="alert" attrs="{'invisible': [('state', '!=', 'draft')]}">
                            Ticket belum dipublish. Silakan klik Publish agar tiket dapat diproses oleh Helpdesk.
                        </div>

                        <!-- 3. INFORMASI TICKET (Direct on sheet, no card model) -->
                        <div class="oe_title mb-3">
                            <h5 class="font-weight-bold text-primary mb-1">INFORMASI TIKET</h5>
                            <h2 class="text-primary font-weight-bold mb-1" attrs="{'invisible': [('name', '=', 'New')]}">
                                <field name="name" readonly="1" class="oe_inline"/>
                            </h2>
                            <div class="form-group mb-0">
                                <label for="title" string="Judul Kendala" class="oe_edit_only font-weight-bold text-muted d-block mb-1"/>
                                <h2>
                                    <field name="title" placeholder="Tuliskan Judul Kendala..." class="w-100"/>
                                </h2>
                            </div>
                        </div>

                        <!-- 4 & 5. DETAIL TICKET (FORM KIRI & FORM KANAN) -->
                        <div class="card p-3 mb-4 bg-light border-0" style="border-radius: 8px;">
                            <h5 class="font-weight-bold text-primary mb-3">DETAIL TICKET</h5>
                            <div class="row">
                                <!-- FORM KIRI -->
                                <div class="col-md-6 border-right">
                                    <group>
                                        <field name="ticket_type" string="Ticket Type"/>
                                        <field name="service_id" string="Service" options="{'no_create': True}"/>
                                        <field name="category_id" string="Category" domain="[('service_id', '=?', service_id)]" options="{'no_create': True}"/>
                                        <field name="subcategory_id" string="Sub Category" domain="[('category_id', '=?', category_id)]" options="{'no_create': True}"/>
                                    </group>
                                </div>
                                <!-- FORM KANAN -->
                                <div class="col-md-6">
                                    <group>
                                        <field name="location_id" string="Department &amp; Location" options="{'no_create': True}"/>
                                        <field name="phone" string="Phone" placeholder="0812-1234-5678"/>
                                        <field name="email" string="Email" placeholder="ahmad.fauzi@hki.co.id"/>
                                        <field name="cc_partner_ids" string="CC" widget="many2many_tags" placeholder="Pilih user untuk CC"/>
                                    </group>
                                </div>
                            </div>
                        </div>

                        <!-- 6. TAB DETAIL (Question & Description) -->
                        <notebook class="mt-4">
                            <page string="Question" name="question">
                                <group string="Penentu Prioritas (5 Pertanyaan)" class="mt-2">
                                    <field name="q1_answer_id" string="1. Siapa yang terdampak?" options="{'no_create': True}"/>
                                    <field name="q2_answer_id" string="2. Apakah mengganggu operasional?" options="{'no_create': True}"/>
                                    <field name="q3_answer_id" string="3. Layanan yang terdampak?" options="{'no_create': True}"/>
                                    <field name="q4_answer_id" string="4. Apakah ada workaround?" options="{'no_create': True}"/>
                                    <field name="q5_answer_id" string="5. Apakah terkait deadline proyek/pekerjaan?" options="{'no_create': True}"/>
                                </group>
                            </page>
                            <page string="Description" name="description">
                                <field name="description" placeholder="Jelaskan permasalahan secara detail..."/>
                                <group string="Attachment" class="mt-3">
                                    <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                                </group>
                            </page>
                            <page string="SLA Time" name="sla_time">
                                <div class="card p-3 border-0 bg-white">
                                    <group>
                                        <group string="Informasi Siklus Waktu Tiket">
                                            <field name="publish_date" string="Tanggal Open Ticket" readonly="1"/>
                                            <field name="start_progress_date" string="Tanggal Start" readonly="1"/>
                                            <field name="resolved_date" string="Tanggal Done" readonly="1"/>
                                        </group>
                                        <group string="Target &amp; Status SLA">
                                            <field name="sla_response_deadline" string="Batas Konfirmasi Helpdesk (Response SLA)" readonly="1" groups="it_helpdesk_v2.group_helpdesk_agent,it_helpdesk_v2.group_helpdesk_manager"/>
                                            <field name="sla_resolution_deadline" string="Tanggal Due Date" readonly="1"/>
                                            <field name="sla_status_color" invisible="1"/>
                                            <field name="sla_status_name" string="Status SLA" widget="badge" readonly="1"
                                                   decoration-success="sla_status_color == 'success'"
                                                   decoration-info="sla_status_color == 'info'"
                                                   decoration-warning="sla_status_color == 'warning'"
                                                   decoration-danger="sla_status_color == 'danger'"/>
                                        </group>
                                    </group>
                                </div>
                            </page>
                            <page string="Penyelesaian &amp; Bukti Solusi (Engineer)" name="resolution_proof" groups="it_helpdesk_v2.group_helpdesk_agent,it_helpdesk_v2.group_helpdesk_manager" attrs="{'invisible': [('is_engineer_or_officer', '=', False)]}">
                                <div class="card p-3 mb-3 border rounded bg-light">
                                    <span class="font-weight-bold d-block text-primary mb-2">Apakah Penyelesaian Tersedia pada Knowledge Base?</span>
                                    <field name="is_kb_solution_available" widget="radio" options="{'horizontal': true}"/>
                                </div>
                                <div class="card p-3 mb-3 border rounded bg-white shadow-sm" attrs="{'invisible': [('is_kb_solution_available', '!=', 'yes')]}">
                                    <label for="selected_knowledge_id" string="Pilih Artikel Knowledge Base Penyelesaian" class="font-weight-bold mb-2 text-success"/>
                                    <field name="selected_knowledge_id" options="{'no_create': True}" placeholder="Pilih dari daftar Kamus Knowledge Base..."/>
                                </div>
                                <div attrs="{'invisible': [('is_kb_solution_available', '=', 'yes')]}">
                                    <div class="card p-3 mb-3 border rounded bg-white shadow-sm d-flex justify-content-between align-items-center flex-row">
                                        <div>
                                            <span class="font-weight-bold d-block text-dark">Publikasikan ke Knowledge Base?</span>
                                            <span class="text-muted small">Aktifkan untuk menyimpan teks tutorial &amp; foto bukti penyelesaian ini ke Kamus Solusi Mandiri saat tiket selesai</span>
                                        </div>
                                        <div>
                                            <field name="is_published_to_kb" widget="boolean_toggle"/>
                                        </div>
                                    </div>
                                    <div class="card p-3 mb-3 border rounded bg-white shadow-sm">
                                        <label for="resolution" string="Langkah-Langkah / Teks Panduan Penyelesaian Kendala (Tutorial)" class="font-weight-bold mb-2 text-primary"/>
                                        <field name="resolution" placeholder="Tuliskan petunjuk, tutorial, atau penjelasan lengkap (dapat me-paste gambar screenshot di sela-sela teks)..."/>
                                    </div>
                                    <div class="card p-3 border rounded bg-white shadow-sm mt-3">
                                        <label for="solution_attachment_ids" string="Bukti Foto Screenshot / File Penyelesaian" class="font-weight-bold mb-2 text-primary"/>
                                        <field name="solution_attachment_ids" widget="many2many_binary"/>
                                    </div>
                                </div>
                            </page>
                        </notebook>
                    </sheet>

                    <!-- 7. LOG NOTE -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_helpdesk_create_ticket" model="ir.actions.act_window">
            <field name="name">Create Ticket</field>
            <field name="res_model">helpdesk.ticket</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_helpdesk_ticket_create_form"/>
            <field name="target">current</field>
            <field name="context">{'default_ticket_type': 'incident'}</field>
        </record>

    </data>
</odoo>
