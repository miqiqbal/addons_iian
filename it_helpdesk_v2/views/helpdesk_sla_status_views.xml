<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_helpdesk_sla_status_list" model="ir.ui.view">
            <field name="name">helpdesk.sla.status.list</field>
            <field name="model">helpdesk.sla.status</field>
            <field name="arch" type="xml">
                <tree create="false" delete="false">
                    <field name="code" readonly="1"/>
                    <field name="name"/>
                    <field name="color"/>
                </tree>
            </field>
        </record>

        <record id="view_helpdesk_sla_status_form" model="ir.ui.view">
            <field name="name">helpdesk.sla.status.form</field>
            <field name="model">helpdesk.sla.status</field>
            <field name="arch" type="xml">
                <form create="false" delete="false">
                    <sheet>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="name"/>
                            <field name="color"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_helpdesk_sla_status" model="ir.actions.act_window">
            <field name="name">SLA Status</field>
            <field name="res_model">helpdesk.sla.status</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>
