<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tree View -->
        <record id="view_helpdesk_ticket_type_tree" model="ir.ui.view">
            <field name="name">helpdesk.ticket.type.tree</field>
            <field name="model">helpdesk.ticket.type</field>
            <field name="arch" type="xml">
                <tree string="Ticket Types">
                    <field name="code" string="Type Code"/>
                    <field name="name" string="Type Name"/>
                    <field name="service_count" string="Jumlah Service"/>
                    <field name="active" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_helpdesk_ticket_type_form" model="ir.ui.view">
            <field name="name">helpdesk.ticket.type.form</field>
            <field name="model">helpdesk.ticket.type</field>
            <field name="arch" type="xml">
                <form string="Ticket Type">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                        <group>
                            <group>
                                <field name="code" string="Type Code" required="1"/>
                                <field name="name" string="Type Name" required="1"/>
                            </group>
                            <group>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Service Catalog Terkait" name="services">
                                <field name="service_ids" readonly="1">
                                    <tree>
                                        <field name="code" string="Catalog Code"/>
                                        <field name="name" string="Service Catalog Name"/>
                                        <field name="engineer_id" string="Default PIC IT"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_helpdesk_ticket_type_search" model="ir.ui.view">
            <field name="name">helpdesk.ticket.type.search</field>
            <field name="model">helpdesk.ticket.type</field>
            <field name="arch" type="xml">
                <search string="Search Ticket Type">
                    <field name="name" string="Type Name"/>
                    <field name="code" string="Type Code"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_helpdesk_ticket_type" model="ir.actions.act_window">
            <field name="name">Ticket Type</field>
            <field name="res_model">helpdesk.ticket.type</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_helpdesk_ticket_type_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Belum ada Ticket Type. Silakan buat baru atau impor file master data.
                </p>
            </field>
        </record>

    </data>
</odoo>
