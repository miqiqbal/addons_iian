<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- helpdesk.service -->
        <record id="view_helpdesk_service_list" model="ir.ui.view">
            <field name="name">helpdesk.service.list</field>
            <field name="model">helpdesk.service</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="code" string="Catalog Code"/>
                    <field name="name" string="Service Catalog Name"/>
                    <field name="type_id" string="Ticket Type"/>
                    <field name="type_code" string="Type Code" optional="show"/>
                    <field name="ticket_type" string="Type Name" widget="badge" optional="hide"
                           decoration-info="ticket_type == 'service_request'"
                           decoration-warning="ticket_type == 'incident'"
                           decoration-danger="ticket_type == 'security_incident'"/>
                    <field name="engineer_id" string="Default PIC IT"/>
                    <field name="is_ticket" widget="boolean_toggle" string="Ticket" optional="show"/>
                    <field name="is_change_request" widget="boolean_toggle" string="Change Request" optional="show"/>
                    <field name="ticket_count" string="Jumlah Case Tiket"/>
                    <button name="action_view_tickets" type="object" string="Lihat Case Tiket" class="btn-primary btn-sm" icon="fa-arrow-right"/>
                </tree>
            </field>
        </record>

        <record id="view_helpdesk_service_form" model="ir.ui.view">
            <field name="name">helpdesk.service.form</field>
            <field name="model">helpdesk.service</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_tickets" type="object" class="oe_stat_button" icon="fa-ticket">
                                <field name="ticket_count" widget="statinfo" string="Case Tiket"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="name"/>
                                <field name="type_id" options="{'no_create': True}"/>
                                <field name="type_code"/>
                                <field name="ticket_type"/>
                            </group>
                            <group>
                                <field name="engineer_id" string="Default PIC IT / Engineer"/>
                                <field name="is_ticket" widget="boolean_toggle" groups="it_helpdesk_v2.group_helpdesk_manager"/>
                                <field name="is_change_request" widget="boolean_toggle" groups="it_helpdesk_v2.group_helpdesk_manager"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_helpdesk_service_search" model="ir.ui.view">
            <field name="name">helpdesk.service.search</field>
            <field name="model">helpdesk.service</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="Service Catalog"/>
                    <field name="code" string="Catalog Code"/>
                    <field name="type_code" string="Type Code"/>
                    <filter string="Tersedia untuk Ticket" name="filter_is_ticket" domain="[('is_ticket', '=', True)]"/>
                    <filter string="Tersedia untuk Change Request" name="filter_is_cr" domain="[('is_change_request', '=', True)]"/>
                    <separator/>
                    <filter string="Service Request" name="filter_sr" domain="[('ticket_type', '=', 'service_request')]"/>
                    <filter string="Incident Operasional TI" name="filter_inc" domain="[('ticket_type', '=', 'incident')]"/>
                    <filter string="Incident Keamanan Informasi" name="filter_sec" domain="[('ticket_type', '=', 'security_incident')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Ticket Type" name="group_ticket_type" domain="[]" context="{'group_by': 'ticket_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_helpdesk_service" model="ir.actions.act_window">
            <field name="name">Service</field>
            <field name="res_model">helpdesk.service</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_helpdesk_service_search"/>
        </record>

