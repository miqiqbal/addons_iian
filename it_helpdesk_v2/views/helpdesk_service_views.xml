        <!-- Dashboard Read-Only Tree & Form Views -->
        <record id="view_helpdesk_service_tree_dashboard" model="ir.ui.view">
            <field name="name">helpdesk.service.tree.dashboard</field>
            <field name="model">helpdesk.service</field>
            <field name="arch" type="xml">
                <tree create="false" edit="false" delete="false" js_class="helpdesk_drilldown_list">
                    <field name="name" string="Nama Service"/>
                    <field name="code" string="Kode"/>
                    <field name="engineer_id" string="Default PIC IT"/>
                    <field name="ticket_count" string="Jumlah Case Tiket"/>
                </tree>
            </field>
        </record>

        <record id="view_helpdesk_service_form_dashboard" model="ir.ui.view">
            <field name="name">helpdesk.service.form.dashboard</field>
            <field name="model">helpdesk.service</field>
            <field name="arch" type="xml">
                <form create="false" edit="false" delete="false">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_tickets" type="object" class="oe_stat_button" icon="fa-ticket">
                                <field name="ticket_count" widget="statinfo" string="Case Tiket"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="engineer_id" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Daftar Case Tiket Relevan">
                                <field name="ticket_ids" readonly="1">
                                    <tree>
                                        <field name="name" string="Ticket No"/>
                                        <field name="title" string="Judul Kendala"/>
                                        <field name="requester_id" string="Pemohon"/>
                                        <field name="created_date" string="Tanggal Create"/>
                                        <field name="priority" string="Priority"/>
                                        <field name="state" string="Status" widget="badge"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_helpdesk_service_dashboard" model="ir.actions.act_window">
            <field name="name">Daftar Jenis Service (Klik Baris untuk Lihat Case Tiket)</field>
            <field name="res_model">helpdesk.service</field>
            <field name="view_mode">tree,form</field>
            <field name="views" eval="[(ref('view_helpdesk_service_tree_dashboard'), 'tree'), (ref('view_helpdesk_service_form_dashboard'), 'form')]"/>
