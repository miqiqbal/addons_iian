<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inherit Users Form View: Clean, Non-Intrusive Tab for Helpdesk Settings -->
        <record id="view_users_form_helpdesk" model="ir.ui.view">
            <field name="name">res.users.form.helpdesk</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <!-- Add an isolated tab in notebook without touching standard title or login fields -->
                <xpath expr="//notebook" position="inside">
                    <page string="IT Helpdesk" name="page_it_helpdesk" groups="it_helpdesk_v2.group_helpdesk_manager">
                        <group string="Helpdesk Engineer Configuration">
                            <group>
                                <field name="initials" string="Initial" placeholder="e.g. AFD"/>
                                <field name="max_daily_quota" string="Batas Kuota Harian (Tiket)"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
