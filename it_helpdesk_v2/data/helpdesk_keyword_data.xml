<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="helpdesk_keyword_rule_0" model="helpdesk.keyword">
            <field name="name">Lupa Password &amp; Akun Akses</field>
            <field name="sequence">5</field>
            <field name="keyword_list">lupa password, reset password, ganti password, password, kata sandi</field>
            <field name="engineer_ids" eval="[(4, ref('user_engineer_dms')), (4, ref('user_engineer_rdw'))]"/>
        </record>

        <record id="helpdesk_keyword_rule_1" model="helpdesk.keyword">
            <field name="name">Aplikasi Keuangan, SAP, ERP/Odoo</field>
            <field name="sequence">10</field>
            <field name="keyword_list">sap, keuangan, bap, ptpp, bapp, invoice, retensi, tagihan, nominal</field>
            <field name="engineer_ids" eval="[(4, ref('user_engineer_afd'))]"/>
        </record>

        <record id="helpdesk_keyword_rule_2" model="helpdesk.keyword">
            <field name="name">Sinkronisasi Data, Bug &amp; Kendala Sistem</field>
            <field name="sequence">20</field>
            <field name="keyword_list">odoo, bug, error, stuck, migrasi, sinkronisasi, gagal upload, tidak match, selisih</field>
            <field name="engineer_ids" eval="[(4, ref('user_engineer_miq')), (4, ref('user_engineer_dwa'))]"/>
        </record>

        <record id="helpdesk_keyword_rule_3" model="helpdesk.keyword">
            <field name="name">Infrastruktur, Jaringan, Hardware &amp; Akses</field>
            <field name="sequence">30</field>
            <field name="keyword_list">internet, wifi, vpn, printer, hardware, email, server, akses, jaringan</field>
            <field name="engineer_ids" eval="[(4, ref('user_engineer_dms')), (4, ref('user_engineer_rdw'))]"/>
        </record>

        <record id="helpdesk_keyword_rule_4" model="helpdesk.keyword">
            <field name="name">Permintaan Fitur &amp; UI/UX (Enhancement)</field>
            <field name="sequence">40</field>
            <field name="keyword_list">tambah fitur, desain, ui, ux, request fitur, tampilan, addendum, dashboard</field>
            <field name="engineer_ids" eval="[(4, ref('user_engineer_bgn'))]"/>
        </record>

    </data>
</odoo>
