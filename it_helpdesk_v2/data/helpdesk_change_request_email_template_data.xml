                        </tr>
                    </table>
                    <div style="margin-top: 25px;">
                        <a href="/web#id=${object.id}&amp;model=helpdesk.change.request&amp;view_type=form"
                           style="background-color: #003366; padding: 12px 20px; color: #ffffff; text-decoration: none; border-radius: 4px; font-weight: bold; display: inline-block;">
                            Review &amp; Approve di Odoo
                        </a>
                    </div>
                    <p style="margin-top: 30px; font-size: 12px; color: #777777;">
                        Email ini dikirim secara otomatis oleh Sistem IT Helpdesk HKI.
                    </p>
                </div>
            </field>
        </record>

        <!-- 3. Notifikasi CR ditolak -->
        <record id="email_template_cr_rejected" model="mail.template">
            <field name="name">IT Helpdesk: CR Ditolak</field>
            <field name="model_id" ref="model_helpdesk_change_request"/>
            <field name="subject">[CR Ditolak] ${object.code or object.name}</field>
            <field name="email_from">rahmadana908@gmail.com</field>
            <field name="email_to">${object.created_by.email or object.email}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px; color: #333333;">
                    <p style="margin: 0px; padding: 0px; font-size: 16px; font-weight: bold; color: #d9534f;">
                        Change Request Anda Ditolak
                    </p>
                    <p style="margin-top: 10px;">
                        Halo ${object.created_by.name or ''}, Change Request berikut telah ditolak:
                    </p>
                    <table style="width: 100%; border-collapse: collapse; margin-top: 15px; margin-bottom: 20px;">
                        <tr style="background-color: #f2f4f7;">
                            <td style="padding: 10px; border: 1px solid #dddddd; font-weight: bold; width: 30%;">No. CR</td>
                            <td style="padding: 10px; border: 1px solid #dddddd;">${object.code or object.name}</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid #dddddd; font-weight: bold;">Request Identification</td>
                            <td style="padding: 10px; border: 1px solid #dddddd;">${object.request_identification or '-'}</td>
                        </tr>
                        <tr style="background-color: #fff3cd;">
                            <td style="padding: 10px; border: 1px solid #ffeeba; font-weight: bold;">Alasan Penolakan</td>
                            <td style="padding: 10px; border: 1px solid #ffeeba; color: #856404; font-weight: bold;">${object.rejection_reason or '-'}</td>
                        </tr>
                    </table>
                    <div style="margin-top: 25px;">
                        <a href="/web#id=${object.id}&amp;model=helpdesk.change.request&amp;view_type=form"
                           style="background-color: #003366; padding: 12px 20px; color: #ffffff; text-decoration: none; border-radius: 4px; font-weight: bold; display: inline-block;">
                            Lihat Detail di Odoo
                        </a>
                    </div>
                    <p style="margin-top: 30px; font-size: 12px; color: #777777;">
                        Email ini dikirim secara otomatis oleh Sistem IT Helpdesk HKI.
                    </p>
                </div>
            </field>
        </record>

        <!-- 4. Notifikasi CR selesai -->
        <record id="email_template_cr_done" model="mail.template">
            <field name="name">IT Helpdesk: CR Selesai</field>
            <field name="model_id" ref="model_helpdesk_change_request"/>
            <field name="subject">[CR Selesai] ${object.code or object.name}</field>
            <field name="email_from">rahmadana908@gmail.com</field>
            <field name="email_to">${object.created_by.email or object.email}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px; color: #333333;">
                    <p style="margin: 0px; padding: 0px; font-size: 16px; font-weight: bold; color: #28a745;">
                        Change Request Anda Telah Selesai
                    </p>
                    <p style="margin-top: 10px;">
                        Halo ${object.created_by.name or ''}, Change Request berikut telah selesai diproses:
                    </p>
                    <table style="width: 100%; border-collapse: collapse; margin-top: 15px; margin-bottom: 20px;">
                        <tr style="background-color: #f2f4f7;">
                            <td style="padding: 10px; border: 1px solid #dddddd; font-weight: bold; width: 30%;">No. CR</td>
                            <td style="padding: 10px; border: 1px solid #dddddd;">${object.code or object.name}</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid #dddddd; font-weight: bold;">Request Identification</td>
                            <td style="padding: 10px; border: 1px solid #dddddd;">${object.request_identification or '-'}</td>
                        </tr>
                        <tr style="background-color: #f2f4f7;">
                            <td style="padding: 10px; border: 1px solid #dddddd; font-weight: bold;">Engineer / PIC IT</td>
                            <td style="padding: 10px; border: 1px solid #dddddd;">${object.engineer_id.name or '-'}</td>
                        </tr>
                    </table>
                    <div style="margin-top: 25px;">
                        <a href="/web#id=${object.id}&amp;model=helpdesk.change.request&amp;view_type=form"
                           style="background-color: #003366; padding: 12px 20px; color: #ffffff; text-decoration: none; border-radius: 4px; font-weight: bold; display: inline-block;">
                            Lihat Detail di Odoo
                        </a>
                    </div>
                    <p style="margin-top: 30px; font-size: 12px; color: #777777;">
                        Email ini dikirim secara otomatis oleh Sistem IT Helpdesk HKI.
                    </p>
                </div>
            </field>
        </record>

    </data>
</odoo>
