<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_ticket_created_requester" model="mail.template">
            <field name="name">Helpdesk: Ticket Created (Requester)</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="subject">Tiket Anda {{ object.name }} telah diterima</field>
            <field name="email_to">{{ object.requester_id.email_formatted }}</field>
            <field name="body_html" type="html">
                <p>Halo <t t-out="object.requester_id.name or ''"/>,</p>
                <p>
                    Tiket Anda <strong t-out="object.name or ''"/> - <t t-out="object.title or ''"/>
                    telah kami terima dan akan segera diproses.
                </p>
                <p>Priority: <t t-out="object.priority_label or '-'"/></p>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_ticket_created_manager" model="mail.template">
            <field name="name">Helpdesk: Ticket Created (Team/Manager)</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="subject">Tiket baru masuk: {{ object.name }}</field>
            <field name="body_html" type="html">
                <p>
                    Tiket baru <strong t-out="object.name or ''"/> - <t t-out="object.title or ''"/>
                    dari <t t-out="object.requester_id.name or ''"/> memerlukan penanganan.
                </p>
                <p>Service: <t t-out="object.service_id.name or '-'"/></p>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_ticket_assigned" model="mail.template">
            <field name="name">Helpdesk: Ticket Assigned</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="subject">Tiket {{ object.name }} di-assign ke Anda</field>
            <field name="email_to">{{ object.engineer_id.email_formatted }}</field>
            <field name="body_html" type="html">
                <p>Halo <t t-out="object.engineer_id.name or ''"/>,</p>
                <p>
                    Tiket <strong t-out="object.name or ''"/> - <t t-out="object.title or ''"/>
                    telah di-assign ke Anda.
                </p>
                <p>Priority: <t t-out="object.priority_label or '-'"/></p>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_ticket_sla_breach" model="mail.template">
            <field name="name">Helpdesk: SLA Breach</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="subject">SLA Breach: {{ object.name }}</field>
            <field name="body_html" type="html">
                <p>
                    Tiket <strong t-out="object.name or ''"/> - <t t-out="object.title or ''"/>
                    telah melewati batas waktu SLA resolution
                    (<t t-out="object.sla_resolution_deadline or ''"/>).
                </p>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_ticket_resolved" model="mail.template">
            <field name="name">Helpdesk: Ticket Resolved</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="subject">Tiket {{ object.name }} telah diselesaikan</field>
            <field name="email_to">{{ object.requester_id.email_formatted }}</field>
            <field name="body_html" type="html">
                <p>Halo <t t-out="object.requester_id.name or ''"/>,</p>
                <p>
                    Tiket Anda <strong t-out="object.name or ''"/> - <t t-out="object.title or ''"/>
                    telah diselesaikan.
                </p>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
