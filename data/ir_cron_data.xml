<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_helpdesk_sla_breach_check" model="ir.cron">
            <field name="name">Cek SLA Breach</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_sla_breach()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_helpdesk_sla_warning_check" model="ir.cron">
            <field name="name">IT Helpdesk: Cek Peringatan SLA 80% (Warning Email)</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_sla_warning()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_helpdesk_auto_escalate_unassigned" model="ir.cron">
            <field name="name">IT Helpdesk: Auto-Eskalasi Tiket Open Kelewat Response SLA</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_escalate_unassigned_tickets()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
